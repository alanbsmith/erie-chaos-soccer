---
interface Props {
  number: string;
  firstName: string;
  lastName: string;
}

const { number, firstName } = Astro.props;
---

<li class="player">
  <div class="player__number">{number}</div>
  <p class="player__first-name">{firstName}</p>
</li>
<style>
  .player {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    /* border: solid 0.125rem #; */
    background: #1a1a1a;
    border-radius: 0.5rem;
    min-height: 5rem;
    grid-column-gap: 1rem;
    min-height: 5rem;
  }

  .player:last-child() {
    margin-bottom: 12rem;
  }


  .player__number {
    display: grid;
    color: #fff;
    background: #333333;
    border-radius: 0.4rem 0 0 0.5rem;
    /* border-inline-end: solid 0.125rem var(--color-border-default); */
    align-items: center;
    justify-items: center;
    font-size: 2rem;
    font-weight: bold;
    height: 5rem;
  }

  .player__first-name {
    margin: 0;
    color: #fff;
    font-size: 1.5rem;
    font-weight: bold;
    align-items: center;
    display: grid;
  }

</style>